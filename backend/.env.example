# --- Serveur ---------------------------------------------------------------
PORT=3000

# Origines autorisées à appeler l'API, séparées par des virgules.
# LAISSER VIDE = toutes les origines sont acceptées : à renseigner
# impérativement avant toute mise en ligne.
FRONTEND_ORIGIN=http://localhost:3001

# --- Base de données -------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Sécurité (chantier 4) -------------------------------------------------
# Mot de passe unique de l'écran de verrouillage.
ADMIN_PASSWORD=

# Secret de signature des jetons de session.
# S'il est absent, ADMIN_PASSWORD est utilisé : changer le mot de passe
# invalide alors toutes les sessions ouvertes.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Secret partagé du webhook email, à configurer côté fournisseur (SendGrid…)
# et à envoyer dans l'en-tête x-webhook-secret.
EMAIL_WEBHOOK_SECRET=

# --- IA --------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Stockage AWS S3 -------------------------------------------------------
# Le bucket doit exister et être PRIVÉ : l'application génère des URLs signées
# à durée limitée, elle ne s'appuie plus sur des objets publics.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
